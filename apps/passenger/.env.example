EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Chave do Maps SDK para Android, restrita ao pacote br.com.clickgo.passageiro + SHA-1
GOOGLE_MAPS_PASSENGER_ANDROID_API_KEY=AIza...

# Futuro build iOS, restrita ao bundle br.com.clickgo.passageiro
GOOGLE_MAPS_PASSENGER_IOS_API_KEY=AIza...

# Rotas/Places NÃO devem ficar no APK. Configure a chave de servidor no backend.
GOOGLE_MAPS_SERVER_API_KEY=AIza...
