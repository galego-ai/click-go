EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel

# Chave do Maps SDK para Android, restrita ao pacote br.com.clickgo.motorista + SHA-1
GOOGLE_MAPS_DRIVER_ANDROID_API_KEY=AIza...

# Futuro build iOS, restrita ao bundle br.com.clickgo.motorista
GOOGLE_MAPS_DRIVER_IOS_API_KEY=AIza...

# Rotas/Places NÃO devem ficar no APK. Configure a chave de servidor no backend.
GOOGLE_MAPS_SERVER_API_KEY=AIza...
